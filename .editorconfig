root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown / MDX
[*.{md,mdx}]
indent_style = space
indent_size = 2
max_line_length = 80
trim_trailing_whitespace = false

# JSON / YAML
[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

# JavaScript / TypeScript
[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 2

# Package files
[{package.json,.prettierrc}]
indent_style = space
indent_size = 2
